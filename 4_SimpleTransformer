    {
      "cell_type": "code",
      "source": [
        "# Create a Training Dataset from text files\n",
        "random.shuffle(train_filenames)\n",
        "train_text_ds = tf_data.TextLineDataset(train_filenames)\n",
        "train_text_ds = train_text_ds.shuffle(buffer_size=256)\n",
        "train_text_ds = train_text_ds.batch(batch_size)\n",
        "\n",
        "# Create a Test Dataset from text files\n",
        "test_text_ds = tf_data.TextLineDataset(test_filenames)\n",
        "test_text_ds = test_text_ds.batch(batch_size)"
      ],
